<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nk.integritypro">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for AdvertisingIdClient to return a real (non-zeroed) ID on targetSdk 33+. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!--
      Package-visibility declarations (targetSdk 30+ hides other apps' packages by default).
      Without these, PackageManager lookups for root-manager/hook-framework apps below
      silently behave as "not found" even when the app IS installed - required for both
      the existing Hook Frameworks check and the new Root Manager Launch Probe to work.
    -->
    <queries>
        <package android:name="de.robv.android.xposed.installer" />
        <package android:name="org.lsposed.manager" />
        <package android:name="io.github.lsposed.manager" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.tsng.hidemyapplist" />
        <package android:name="me.bmax.apatch" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.GoogleAPINilesh">

        <activity
            android:name="com.nk.integritypro.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>